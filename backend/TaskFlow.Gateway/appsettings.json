{
  "Jwt": {
    "Secret": "taskflow-dev-secret-replace-this-in-production-min32chars!",
    "Issuer": "TaskFlowAPI",
    "Audience": "TaskFlowClient"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "projects-route": {
        "ClusterId": "projects-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/projects/{**catch-all}" }
      },
      "tasks-route": {
        "ClusterId": "projects-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/tasks/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "primary": { "Address": "http://auth-api:5001/" }
        }
      },
      "projects-cluster": {
        "Destinations": {
          "primary": { "Address": "http://projects-api:5002/" }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "primary": { "Address": "http://notifications-api:5003/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
